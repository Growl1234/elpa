# The configure provider resolves the compiler interface, integer ABI and BLACS.
# Set --with-mkl-threading/--with-blas-interface in the job when non-default.
export MKLROOT="${MKLROOT:-${MKL_HOME:-}}"

export ASAN_OPTIONS=suppressions=./ci_test_scripts/no_asan_for_mpi.supp,fast_unwind_on_malloc=0
export LSAN_OPTIONS=suppressions=./ci_test_scripts/no_lsan_for_mpi.supp


export I_MPI_DEBUG=5
module list
